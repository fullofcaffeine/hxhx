{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hxhx.dev/schema/hxhx-backend-plugin-manifest-v1.schema.json",
  "title": "HXHX Backend Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pluginId",
    "pluginVersion",
    "backend",
    "requires"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "pluginId": {
      "type": "string",
      "minLength": 1
    },
    "pluginVersion": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry",
        "targetIds"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "haxe-provider",
            "ocaml-cmxs"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "targetIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abiVersion",
        "genIrVersion",
        "macroApiVersion"
      ],
      "properties": {
        "abiVersion": {
          "type": "integer",
          "const": 1
        },
        "genIrVersion": {
          "type": "integer",
          "const": 1
        },
        "macroApiVersion": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
