#!/usr/bin/env bash
set -euo pipefail

# HXHX_BD_POST_CHECKOUT_FAST_PATH_V1
#
# Git can invoke post-checkout with identical old and new object IDs during a
# no-op rebase. No tracked checkout content changed in that case, so importing
# the complete Beads JSONL cannot discover anything new and may overwrite newer
# local database state with an older staged export.

HOOKS_DIR="$(git rev-parse --git-path hooks)"
if [[ "$HOOKS_DIR" != /* ]]; then
	HOOKS_DIR="$(git rev-parse --show-toplevel)/$HOOKS_DIR"
fi

USER_HOOK="$HOOKS_DIR/post-checkout.user"
BD_HOOK="$HOOKS_DIR/post-checkout.bd"
CHECKOUT_STATE="$(git rev-parse --git-path hxhx-post-checkout-state)"
if [[ "$CHECKOUT_STATE" != /* ]]; then
	CHECKOUT_STATE="$(git rev-parse --show-toplevel)/$CHECKOUT_STATE"
fi

is_git_object_id() {
	local value="$1"
	local length="${#value}"

	if [[ "$length" -ne 40 && "$length" -ne 64 ]]; then
		return 1
	fi

	case "$value" in
		*[!0-9a-fA-F]*) return 1 ;;
		*) return 0 ;;
	esac
}

rebase_head_name() {
	local candidate
	local candidate_path
	local branch

	for candidate in rebase-merge/head-name rebase-apply/head-name; do
		candidate_path="$(git rev-parse --git-path "$candidate")"
		if [[ "$candidate_path" != /* ]]; then
			candidate_path="$(git rev-parse --show-toplevel)/$candidate_path"
		fi
		if [[ ! -f "$candidate_path" ]]; then
			continue
		fi

		IFS= read -r branch <"$candidate_path" || true
		case "$branch" in
			refs/heads/*)
				printf '%s\n' "$branch"
				return 0
				;;
		esac
	done

	return 1
}

current_checkout_identity() {
	local branch
	local head

	if ! head="$(git rev-parse --verify HEAD 2>/dev/null)"; then
		return 1
	fi

	if branch="$(git symbolic-ref --quiet HEAD 2>/dev/null)"; then
		printf 'branch:%s@%s\n' "$branch" "$head"
	elif branch="$(rebase_head_name)"; then
		printf 'branch:%s@%s\n' "$branch" "$head"
	else
		printf 'detached:%s\n' "$head"
	fi
}

record_checkout_identity() {
	local current
	local temporary_state

	if ! current="$(current_checkout_identity)"; then
		return 0
	fi

	mkdir -p "$(dirname "$CHECKOUT_STATE")"
	temporary_state="$CHECKOUT_STATE.tmp.$$"
	printf '%s\n' "$current" >"$temporary_state"
	mv "$temporary_state" "$CHECKOUT_STATE"
}

is_redundant_branch_checkout() {
	local current
	local head
	local previous

	if [[ "$#" -ne 3 ]]; then
		return 1
	fi

	if [[ "$3" != "1" || "$1" != "$2" ]]; then
		return 1
	fi

	if ! is_git_object_id "$1" || [[ ! -f "$CHECKOUT_STATE" ]]; then
		return 1
	fi

	if ! current="$(current_checkout_identity)"; then
		return 1
	fi
	if ! head="$(git rev-parse --verify HEAD 2>/dev/null)" || [[ "$2" != "$head" ]]; then
		return 1
	fi
	previous="$(<"$CHECKOUT_STATE")"

	[[ "$current" == "$previous" ]]
}

# A pre-existing user hook is independent from Beads and must still observe
# every checkout, including Git's identical-commit notification.
if [[ -x "$USER_HOOK" ]]; then
	"$USER_HOOK" "$@"
fi

if is_redundant_branch_checkout "$@"; then
	if [[ "${HXHX_HOOK_TRACE:-0}" == "1" ]]; then
		echo "[post-checkout] identical branch and commit; skipped redundant Beads import"
	fi
	exit 0
fi

# Preserve the exact installed Beads shim when the repository hook installer
# found one. Fall back to the current CLI so a fresh checkout still works when
# only this repository-owned hook has been installed.
if [[ -x "$BD_HOOK" ]]; then
	"$BD_HOOK" "$@"
	record_checkout_identity
	exit 0
fi

if command -v bd >/dev/null 2>&1; then
	bd hooks run post-checkout "$@"
	record_checkout_identity
	exit 0
fi

record_checkout_identity
exit 0
