#!/usr/bin/env bash
set -euo pipefail

# HXHX_POST_CHECKOUT_USER_ONLY_V1
# Git changes source history, not the live Beads database. Run only the
# preserved user hook; task synchronization and recovery are explicit actions.

HOOKS_DIR="$(git rev-parse --git-path hooks)"
if [[ "$HOOKS_DIR" != /* ]]; then
	HOOKS_DIR="$(git rev-parse --show-toplevel)/$HOOKS_DIR"
fi

USER_HOOK="$HOOKS_DIR/post-checkout.user"
if [[ -x "$USER_HOOK" ]]; then
	"$USER_HOOK" "$@"
fi
