{
  "schema": "hxhx.qa-risk-policy.v1",
  "defaultUnknownTier": "Q2",
  "eventMinimums": {
    "release": "Q4",
    "schedule": "Q3",
    "workflow_dispatch": "Q3"
  },
  "q0WorkflowIgnorePatterns": [
    ".beads/**",
    ".github/ISSUE_TEMPLATE/**",
    "docs/**",
    "*.md",
    "**/*.md"
  ],
  "q1HxhxWorkflowIgnorePatterns": [
    "bench/**",
    "packages/reflaxe.ocaml/examples/build-macro/**",
    "packages/reflaxe.ocaml/examples/extlib-pmap/**",
    "packages/reflaxe.ocaml/examples/file-io/**",
    "packages/reflaxe.ocaml/examples/loop-control/**",
    "packages/reflaxe.ocaml/examples/mini-compiler/**",
    "packages/reflaxe.ocaml/examples/ocaml-native-collections/**",
    "scripts/bench/**",
    "scripts/reflaxe-ocaml/**",
    "test/packaging/reflaxe_ocaml_external_app/**",
    "test/portable/**",
    "test/reflaxe_ocaml_tooling_*/**",
    "workloads/**"
  ],
  "rules": [
    {
      "id": "documentation-and-tracking",
      "tier": "Q0",
      "terminal": true,
      "description": "Documentation, repository guidance, and Beads records do not need a compiler build.",
      "exact": [
        "AGENTS.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "PROVENANCE.md",
        "README.md",
        "RELEASING.md",
        "THIRD_PARTY_NOTICES.md"
      ],
      "prefixes": [
        ".beads/",
        ".github/ISSUE_TEMPLATE/",
        "docs/"
      ],
      "suffixes": [
        ".md"
      ]
    },
    {
      "id": "standalone-reflaxe-ocaml-surface",
      "tier": "Q1",
      "description": "Standalone examples, package consumers, and authoring tools exercise reflaxe.ocaml without a large hxhx consumer.",
      "prefixes": [
        "bench/",
        "examples/",
        "packages/reflaxe.ocaml/examples/",
        "scripts/bench/",
        "scripts/reflaxe-ocaml/",
        "test/packaging/reflaxe_ocaml_external_app/",
        "test/portable/",
        "test/reflaxe_ocaml_tooling_",
        "workloads/"
      ]
    },
    {
      "id": "target-or-compiler-contract",
      "tier": "Q2",
      "description": "Target lowering, hxhx source, focused compiler fixtures, and their ordinary tooling require the bounded hxhx contract canary.",
      "exact": [
        ".haxerc",
        "extraParams.hxml",
        "haxelib.json",
        "hxformat.json"
      ],
      "prefixes": [
        "examples/hxhx-",
        "haxe_libraries/",
        "packages/hxhx-core/src/",
        "packages/hxhx/src/",
        "packages/reflaxe.ocaml/examples/hxhx-",
        "packages/reflaxe.ocaml/src/",
        "packages/reflaxe.ocaml/std/",
        "packages/reflaxe.ocaml/templates/",
        "scripts/hxhx/",
        "scripts/stdlib/",
        "test/fixtures/",
        "test/oracle/",
        "test/snapshot/",
        "test/upstream_shims/"
      ]
    },
    {
      "id": "central-target-representation",
      "tier": "Q3",
      "description": "Central OCaml representation, lowering, and runtime changes require the large hxhx consumer in addition to focused target proof.",
      "exact": [
        "packages/reflaxe.ocaml/src/reflaxe/ocaml/OcamlCompiler.hx",
        "packages/reflaxe.ocaml/src/reflaxe/ocaml/ast/OcamlBuilder.hx"
      ],
      "prefixes": [
        "packages/reflaxe.ocaml/src/reflaxe/ocaml/runtimegen/",
        "packages/reflaxe.ocaml/std/runtime/"
      ]
    },
    {
      "id": "bootstrap-plugin-or-toolchain-contract",
      "tier": "Q3",
      "description": "Bootstrap snapshots, plugin ABI/loaders, macro host, workflow routing, and toolchain locks require large-consumer and authentic-promotion evidence.",
      "exact": [
        "package-lock.json",
        "package.json",
        "packages/hxhx/src/hxhx/BackendPluginLoadRequest.hx",
        "packages/hxhx/src/hxhx/BackendPluginLoader.hx",
        "packages/hxhx/src/hxhx/BackendPluginManifestResolver.hx",
        "packages/hxhx/src/hxhx/BackendPluginSource.hx",
        "packages/hxhx/src/hxhx/NativeBackendPluginDynlink.hx",
        "packages/hxhx/src/hxhx/NativeBackendPluginHost.hx",
        "packages/hxhx/src/hxhx/NativeBackendPluginHostAbi.hx",
        "packages/hxhx/src/hxhx/NativeBackendPluginLoader.hx",
        "packages/hxhx/src/hxhx/Stage3BackendPluginSupport.hx",
        "scripts/ci/ci-evidence-ownership-fixture-test.js",
        "scripts/ci/ci-evidence-ownership.js",
        "scripts/ci/core-test-aggregate.js",
        "scripts/ci/core-test-shard-fixture-test.js",
        "scripts/ci/core-test-shard.js",
        "scripts/ci/core-test-shards.js",
        "scripts/ci/core-test-shards.json",
        "scripts/ci/github-api-json-fixture-test.js",
        "scripts/ci/github-api-json.js",
        "scripts/ci/qa-risk-classifier-fixture-test.js",
        "scripts/ci/qa-risk-classifier.js",
        "scripts/ci/qa-risk-policy.json",
        "scripts/ci/qa-risk-workflow-contract-check.js",
        "scripts/hxhx/build-hxhx.sh",
        "scripts/hxhx/build-hxhx-macro-host.sh"
      ],
      "prefixes": [
        ".github/workflows/",
        "packages/hxhx/bootstrap_out/",
        "packages/hxhx-core/src/backend/plugin/",
        "packages/hxhx-core/src/hxhxmacrohost/",
        "packages/hxhx-macro-host/",
        "scripts/release/"
      ]
    }
  ]
}
