@@ -347,0 +348,22 @@ class HaxeLexer extends Lexer implements hxparse.RuleBuilder {
+	/**
+		Markup needs a closing tag or a self-closing delimiter. Check their ASCII
+		bytes before decoding the remaining input: ordinary generic types often
+		have neither, and repeatedly decoding a large suffix creates quadratic
+		allocation. This is only a rejection check; the existing scan still decides
+		which tag closes the expression. Non-ASCII input keeps the decoder's
+		behavior, including malformed byte sequences. Do not retain results across
+		lexer calls.
+	**/
+	static function hasMarkupClosing(input:byte.ByteData, start:Int):Bool {
+		var index = start;
+		while (index < input.length) {
+			var current = input.readByte(index);
+			if (current >= 128) return true;
+			if (index + 1 < input.length
+				&& ((current == '<'.code && input.readByte(index + 1) == '/'.code)
+					|| (current == '/'.code && input.readByte(index + 1) == '>'.code))) return true;
+			index++;
+		}
+		return false;
+	}
+
@@ -350,0 +373,5 @@ class HaxeLexer extends Lexer implements hxparse.RuleBuilder {
+		if (!hasMarkupClosing(lexer.input, startPos)) {
+			lexer.pos = startPos + 1;
+			lexer.current = "<";
+			return mk(lexer, Binop(OpLt));
+		}
