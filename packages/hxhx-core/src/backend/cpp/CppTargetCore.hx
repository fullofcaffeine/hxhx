		out.push("static std::string __hxhx_stringify(const std::vector<T>& values) {");
		out.push("  std::ostringstream out;");
		out.push("  out << \"[\";");
		out.push("  for (std::size_t i = 0; i < values.size(); ++i) {");
		out.push("    if (i > 0) out << \",\";");
		out.push("    out << __hxhx_stringify(values[i]);");
