	static function renderOpaqueTypedLocalInitRaw(raw:String):Null<String> {
		final compact = compactRawText(raw);
		final pattern = ~/^opaque_block_expr:\{var([A-Za-z_][A-Za-z0-9_]*):([^=;{}]+)=([A-Za-z_][A-Za-z0-9_]*|"[^"]*"|-?[0-9.]+);\}$/;
