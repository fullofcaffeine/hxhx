package backend.ocaml;

/**
	Generates the load-time entry of a project-macro plugin built by the Stage3 OCaml emitter.

	Input (compiler defines):
	- `-D ocaml_plugin_register_macro=<plugin id>`
	- `-D ocaml_plugin_macro_declarations=<pack.Type.method>[,<pack.Type.method>...]`

	For each listed declaration the entry registers one adapter with
	`HxHxMacroModuleHost.register_macro_declaration`. The adapter is the typed bridge
	`Array<haxe.macro.Expr> -> haxe.macro.Expr` that calls the real macro method compiled into the
	plugin, for example:

	```ocaml
	HxHxMacroModuleHost.register_macro_declaration "my.plugin" "Identity.preserve"
	  (fun payload -> Hxhxmacrohost_MacroDeclarationPlugin.invoke payload 1
		(fun args -> Identity.preserve (HxBootArray.get (Obj.magic args) 0)));
	```

	`MacroDeclarationPlugin.invoke` (Haxe-authored) decodes the argument payload, checks the count,
	calls the adapter, and encodes the result or the macro's failure. The declaration is checked
	against the parsed program first: it must be a static `macro` method whose parameters are all
	required `Expr` values and whose declared result is `Expr`. Anything else is rejected while the
	plugin is generated, so a plugin never registers a callback with the wrong shape.

	The old `-D ocaml_plugin_macro_expr` / `-D ocaml_plugin_macro_handler` pair registered a
	`unit -> string` source-text handler. It was removed with plugin ABI version 2 and is rejected.
**/
class Stage3OcamlMacroPluginEntry {
	public static inline final DECLARATIONS_DEFINE:String = "ocaml_plugin_macro_declarations";
	public static inline final PLUGIN_ENTRY_TYPE:String = "hxhxmacrohost.MacroDeclarationPlugin";

	/**
		The dune library name of a project-macro plugin, derived from its plugin id.

		Dynlink refuses to load a compilation unit whose name is already loaded, and a plugin
		compiles standard-library modules such as `StringBuf` that the compiler binary also
		contains. Building the plugin as a wrapped dune library gives every generated module a
		library-qualified unit name (`<library>__StringBuf`). The shared runtime library stays a
		separate dependency, so the plugin registers into the compiler's own registration table.
	**/
	public static function libraryName(pluginId:String):String {
		final out = new StringBuf();
		out.add("hxhx_macro_plugin_");
		for (index in 0...pluginId.length) {
			final code = pluginId.charCodeAt(index);
			final keep = code >= "a".code && code <= "z".code || code >= "0".code && code <= "9".code;
			final upper = code >= "A".code && code <= "Z".code;
			out.add(keep ? String.fromCharCode(code) : upper ? String.fromCharCode(code + 32) : "_");
		}
		return out.toString();
	}

	/**
		The dune stanza for a project-macro plugin library; it builds `<library>.cma` and `<library>.cmxs`.

		The current Stage3 function emitter can conservatively write `let rec` for the selected
		macro methods, and a plugin also compiles standard-library modules whose generated
		placeholder bodies leave parameters unused. Dune's dev profile promotes those warnings to
		errors; the ordinary Stage3 executable build does not. This bounded plugin form therefore
		keeps warnings visible but not fatal, and silences only the unused `rec` warning.
	**/
	public static function duneStanza(library:String):String {
		return "; -warn-error -a is deliberate: this library is generated code, so warnings stay visible but never fail the build.\n"
			+ "(library\n (name "
			+ library
			+
			")\n (modules :standard)\n (libraries hx_runtime unix str threads dynlink)\n (flags (:standard -w -39 -warn-error -a)))\n\n; Generated by hxhx(stage3)\n";
	}

	/** The configured declaration keys, in order; empty when the define is absent. */
	public static function declarations(raw:Null<String>):Array<String> {
		final out = new Array<String>();
		if (raw == null)
			return out;
		for (entry in raw.split(",")) {
			final key = StringTools.trim(entry);
			if (key.length == 0)
				continue;
			if (!isTypePath(key) || key.indexOf(".") <= 0)
				throw "invalid -D " + DECLARATIONS_DEFINE + " entry `" + key + "`; expected <pack.Type.method>";
			if (out.indexOf(key) >= 0)
				throw "duplicate -D " + DECLARATIONS_DEFINE + " entry `" + key + "`";
			out.push(key);
		}
		return out;
	}

	/** Type paths the plugin compilation must parse so the macro owners are compiled into it. */
	public static function ownerTypePaths(raw:Null<String>):Array<String> {
		final out = new Array<String>();
		for (key in declarations(raw)) {
			final owner = key.substr(0, key.lastIndexOf("."));
			if (out.indexOf(owner) < 0)
				out.push(owner);
		}
		return out;
	}

	/**
		Render the registration statements for one plugin.

		`moduleName` maps a Haxe type path to its emitted OCaml module, `valueIdent` maps a method
		name to its OCaml identifier, and `quote` escapes an OCaml string literal body; all three
		are the emitter's own naming functions.
	**/
	public static function render(pluginId:String, keys:Array<String>, modules:Array<TypedModule>, moduleName:String->String, valueIdent:String->String,
			quote:String->String):Array<String> {
		if (keys.length == 0)
			throw "project macro plugin entry requires -D " + DECLARATIONS_DEFINE + "=<pack.Type.method>";
		final entryModule = moduleName(PLUGIN_ENTRY_TYPE);
		final lines = new Array<String>();
		for (key in keys) {
			final separator = key.lastIndexOf(".");
			final owner = key.substr(0, separator);
			final method = key.substr(separator + 1);
			final arity = checkedArity(key, owner, method, modules);
			final arguments = [for (index in 0...arity) "(HxBootArray.get (Obj.magic args) " + index + ")"];
			final call = moduleName(owner) + "." + valueIdent(method) + " " + (arity == 0 ? "()" : arguments.join(" "));
			lines.push("  HxHxMacroModuleHost.register_macro_declaration \"" + quote(pluginId) + "\" \"" + quote(key) + "\"");
			lines.push("    (fun payload -> "
				+ entryModule
				+ "."
				+ valueIdent("invoke")
				+ " payload "
				+ arity
				+ " (fun args -> "
				+ call
				+ "));");
		}
		lines.push("  ()");
		return lines;
	}

	static function checkedArity(key:String, owner:String, method:String, modules:Array<TypedModule>):Int {
		for (typed in modules) {
			final declaration = typed.getBackendDeclaration();
			final packagePath = HxModuleDecl.getPackagePath(declaration);
			for (source in HxModuleDecl.getClasses(declaration)) {
				final name = HxClassDecl.getName(source);
				final fullName = packagePath.length == 0 ? name : packagePath + "." + name;
				if (fullName != owner)
					continue;
				for (candidate in HxClassDecl.getFunctions(source)) {
					if (HxFunctionDecl.getName(candidate) != method)
						continue;
					final unsupported = unsupportedDeclarationShape(key, candidate);
					if (unsupported != null)
						throw unsupported;
					return HxFunctionDecl.getArgs(candidate).length;
				}
				throw "project macro declaration `" + key + "` names no method of " + owner;
			}
		}
		throw "project macro declaration `" + key + "` names no compiled class " + owner;
	}

	/**
		Why the declaration `key` cannot be registered in a project-macro plugin, or `null` when it can.

		A plugin adapter has the shape `Array<haxe.macro.Expr> -> haxe.macro.Expr`, so the declaration
		must be a static `macro` method whose parameters are all required `Expr` values and whose
		declared result is `Expr`. The compiler asks this before it builds a plugin, so an unsupported
		declaration is reported at its call instead of failing a plugin build.
	**/
	public static function unsupportedDeclarationShape(key:String, candidate:HxFunctionDecl):Null<String> {
		if (!HxFunctionDecl.getIsStatic(candidate) || HxFunctionDecl.getMetadata(candidate).indexOf("macro") < 0)
			return "project macro declaration `" + key + "` is not a static macro method";
		for (argument in HxFunctionDecl.getArgs(candidate)) {
			if (HxFunctionArg.getIsOptional(argument)
				|| HxFunctionArg.getIsRest(argument)
				|| !isExprType(HxFunctionArg.getTypeHint(argument)))
				return "project macro declaration `"
					+ key
					+ "` parameter `"
					+ HxFunctionArg.getName(argument)
					+ "` must be a required haxe.macro.Expr; other parameter kinds are not supported yet";
		}
		if (!isExprType(HxFunctionDecl.getReturnTypeHint(candidate)))
			return "project macro declaration `" + key + "` must declare an haxe.macro.Expr result";
		return null;
	}

	static function isExprType(typeHint:Null<String>):Bool {
		final text = typeHint == null ? "" : StringTools.trim(typeHint);
		return text == "Expr" || text == "haxe.macro.Expr" || text == "haxe.macro.Expr.Expr";
	}

	static function isTypePath(value:String):Bool {
		for (part in value.split(".")) {
			if (part.length == 0)
				return false;
			for (index in 0...part.length) {
				final code = part.charCodeAt(index);
				final valid = code >= "A".code && code <= "Z".code || code >= "a".code && code <= "z".code || code == "_".code || index > 0
					&& code >= "0".code && code <= "9".code;
				if (!valid)
					return false;
			}
		}
		return true;
	}
}
