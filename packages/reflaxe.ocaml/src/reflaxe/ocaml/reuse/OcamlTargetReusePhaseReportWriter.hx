package reflaxe.ocaml.reuse;

#if (macro || reflaxe_runtime)
import haxe.Json;
import haxe.io.Path;
import reflaxe.lifecycle.FinalProgramFingerprintSnapshot;
import reflaxe.lifecycle.TargetReuseCatalog.TargetReuseCatalogRealmObservation;
import reflaxe.lifecycle.TargetReuseCatalog.TargetReuseCatalogStats;
import reflaxe.lifecycle.TargetReuseProbe;
import reflaxe.lifecycle.TargetReuseRequestOutcome;
import sys.FileSystem;
import sys.io.File;
#if eval
import eval.vm.Gc;
#end

/** Records which expensive generation steps ran, so a cache hit cannot be confused with a rebuild. **/
typedef OcamlTargetReusePhaseWork = {
	final semanticCompilerRan:Bool;
	final missPreparationRan:Bool;
	final lookupRan:Bool;
	final replaySucceeded:Bool;
	final payloadBytes:Null<Int>;
}

/** Measures work after Haxe has reduced the typed program and its inputs to a stable identity. **/
typedef OcamlTargetReusePhaseTiming = {
	final targetRevisionObservationMilliseconds:Int;
	final finalProgramFingerprintAndKeyMilliseconds:Int;
	final targetLifecycleMilliseconds:Int;
	final missPreparationMilliseconds:Int;
	final lookupMilliseconds:Int;
	final payloadValidationMilliseconds:Int;
	final replayFilesMilliseconds:Int;
	final replayReceiptAndManifestMilliseconds:Int;
	final outputPublicationMilliseconds:Int;
}

/**
	Writes one external, redacted receipt for an OCaml code-generation request.

	"Target reuse" means that an unchanged typed Haxe program can reuse the
	complete OCaml source tree generated by an earlier successful request. A hit
	still validates the stored files, rebuilds current ownership manifests, and
	publishes through a fresh output transaction; it skips whole-program OCaml
	analysis, lowering, and printing. Any changed or uncertain input is a miss
	and runs the ordinary compiler.

	The report directory comes from the long-lived compiler process environment,
	not a source-affecting Haxe define. Reports therefore do not participate in
	generated output, artifact manifests, or the identity of the cached source
	tree.
	Writing is best-effort: benchmark and qualification runners require the
	expected receipt, while an unavailable report directory cannot turn a
	successfully published user compilation into a failure.
**/
class OcamlTargetReusePhaseReportWriter {
	public static inline final ENVIRONMENT_VARIABLE = "REFLAXE_OCAML_TARGET_REUSE_PHASE_REPORT_DIR";
	public static inline final MODEL = "reflaxe-ocaml-target-reuse-phase";
	public static inline final SCHEMA_VERSION = 2;

	/** Writes the current request receipt only when the server was given an external report directory. **/
	public static function tryWrite(snapshot:FinalProgramFingerprintSnapshot, probe:TargetReuseProbe, outcome:TargetReuseRequestOutcome,
			realm:TargetReuseCatalogRealmObservation, catalog:TargetReuseCatalogStats, timing:OcamlTargetReusePhaseTiming,
			work:OcamlTargetReusePhaseWork):Void {
		final directory = Sys.getEnv(ENVIRONMENT_VARIABLE);
		if (directory == null || directory.length == 0)
			return;
		try {
			write(directory, snapshot, probe, outcome, realm, catalog, timing, work);
		} catch (_:Dynamic) {
			// Generated source may already be public here. A missing benchmark
			// receipt must not retroactively fail an otherwise valid compilation;
			// the qualification runner rejects the missing evidence instead.
		}
	}

	static function write(directory:String, snapshot:FinalProgramFingerprintSnapshot, probe:TargetReuseProbe, outcome:TargetReuseRequestOutcome,
			realm:TargetReuseCatalogRealmObservation, catalog:TargetReuseCatalogStats, timing:OcamlTargetReusePhaseTiming,
			work:OcamlTargetReusePhaseWork):Void {
		ensureDirectory(directory);
		final blockers = probe.blockers();
		blockers.sort(Reflect.compare);
		final report = {
			schemaVersion: SCHEMA_VERSION,
			model: MODEL,
			outcome: outcomeName(outcome),
			finalProgram: {
				revision: reportHash(snapshot.id, "final-program revision"),
				programMembershipRevision: reportHash(snapshot.programMembershipRevision, "program-membership revision"),
				hostRequestRevision: reportHash(snapshot.hostRequestRevision, "host-request revision"),
				compatibilityProgramRevision: reportHash(snapshot.programRevision.id, "compatibility-program revision"),
				declarationCount: snapshot.declarations().length
			},
			targetRequest: {
				namespace: OcamlTargetReuseContract.NAMESPACE,
				revision: reportOptionalHash(probe.requestRevision, "target-source request revision"),
				eligible: probe.eligible,
				blockers: blockers
			},
			timing: {
				targetRevisionObservationMilliseconds: nonNegative(timing.targetRevisionObservationMilliseconds, "target revision observation"),
				finalProgramFingerprintAndKeyMilliseconds: nonNegative(timing.finalProgramFingerprintAndKeyMilliseconds, "final-program fingerprint and key"),
				targetLifecycleMilliseconds: nonNegative(timing.targetLifecycleMilliseconds, "target lifecycle"),
				missPreparationMilliseconds: nonNegative(timing.missPreparationMilliseconds, "miss preparation"),
				lookupMilliseconds: nonNegative(timing.lookupMilliseconds, "catalog lookup"),
				payloadValidationMilliseconds: nonNegative(timing.payloadValidationMilliseconds, "payload validation"),
				replayFilesMilliseconds: nonNegative(timing.replayFilesMilliseconds, "source-bundle file replay"),
				replayReceiptAndManifestMilliseconds: nonNegative(timing.replayReceiptAndManifestMilliseconds, "receipt and manifest replay"),
				outputPublicationMilliseconds: nonNegative(timing.outputPublicationMilliseconds, "output publication")
			},
			work: {
				semanticCompilerRan: work.semanticCompilerRan,
				missPreparationRan: work.missPreparationRan,
				lookupRan: work.lookupRan,
				replaySucceeded: work.replaySucceeded,
				payloadBytes: work.payloadBytes
			},
			macroRealm: {
				identityRevision: reportHash(realm.identityRevision, "macro-realm identity"),
				requestSequence: realm.requestSequence,
				survivedPriorRequest: realm.survivedPriorRequest,
				resetGeneration: realm.resetGeneration,
				resetCause: realm.lastResetCause
			},
			catalog: {
				totalBudgetBytes: catalog.totalBudgetBytes,
				maximumEntryBytes: catalog.maximumEntryBytes,
				entryCount: catalog.entryCount,
				payloadBytes: catalog.payloadBytes,
				estimatedOverheadBytes: catalog.estimatedOverheadBytes,
				activeLeases: catalog.activeLeases,
				hits: catalog.hits,
				misses: catalog.misses,
				ineligibleRequests: catalog.ineligibleRequests,
				admissions: catalog.admissions,
				rejectedAdmissions: catalog.rejectedAdmissions,
				evictions: catalog.evictions,
				quarantines: catalog.quarantines
			},
			gc: gcObservation()
		};
		final name = "request-" + StringTools.lpad(Std.string(realm.requestSequence), "0", 6) + ".json";
		final path = Path.join([directory, name]);
		final temporaryPath = path + ".tmp";
		File.saveContent(temporaryPath, Json.stringify(report, null, "  ") + "\n");
		if (FileSystem.exists(path))
			FileSystem.deleteFile(path);
		FileSystem.rename(temporaryPath, path);
	}

	static function ensureDirectory(path:String):Void {
		if (FileSystem.exists(path)) {
			if (!FileSystem.isDirectory(path))
				throw "OCaml target reuse phase report path is not a directory.";
			return;
		}
		final parent = Path.directory(path);
		if (parent != null && parent.length > 0 && parent != path)
			ensureDirectory(parent);
		FileSystem.createDirectory(path);
	}

	static function outcomeName(outcome:TargetReuseRequestOutcome):String {
		return switch (outcome) {
			case CompiledMiss: "compiled-miss";
			case ExactHit: "exact-hit";
			case Failed: "failed";
		};
	}

	static function gcObservation() {
		#if eval
		final stats = Gc.stat();
		final overflowedFields:Array<String> = [];
		final heapWords = gcInteger(stats.heap_words, "heapWords", overflowedFields);
		final liveWords = gcInteger(stats.live_words, "liveWords", overflowedFields);
		final freeWords = gcInteger(stats.free_words, "freeWords", overflowedFields);
		final topHeapWords = gcInteger(stats.top_heap_words, "topHeapWords", overflowedFields);
		final compactions = gcInteger(stats.compactions, "compactions", overflowedFields);
		final stackWords = gcInteger(stats.stack_size, "stackWords", overflowedFields);
		return {
			status: overflowedFields.length == 0 ? "observed" : "partial-overflow",
			heapWords: heapWords,
			liveWords: liveWords,
			freeWords: freeWords,
			topHeapWords: topHeapWords,
			minorCollections: stats.minor_collections,
			majorCollections: stats.major_collections,
			compactions: compactions,
			stackWords: stackWords,
			overflowedFields: overflowedFields
		};
		#else
		return {
			status: "unavailable",
			heapWords: 0,
			liveWords: 0,
			freeWords: 0,
			topHeapWords: 0,
			minorCollections: 0.0,
			majorCollections: 0.0,
			compactions: 0,
			stackWords: 0,
			overflowedFields: []
		};
		#end
	}

	/**
		Reports one evaluator GC counter without inventing a larger value.

		Haxe 4.3.7 exposes several native OCaml counters as 32-bit Haxe `Int`
		values. A sufficiently large compiler process can therefore present a
		valid native count as a negative wrapped value. The phase report records
		that field as `null` and names it in `overflowedFields`; current RSS and
		every counter that still fits remain available to the evidence checker.
	**/
	static function gcInteger(value:Int, field:String, overflowedFields:Array<String>):Null<Int> {
		if (value >= 0)
			return value;
		overflowedFields.push(field);
		return null;
	}

	static function nonNegative(value:Int, label:String):Int {
		if (value < 0)
			throw 'OCaml target reuse $label duration must not be negative.';
		return value;
	}

	static function reportOptionalHash(value:Null<String>, label:String):Null<String> {
		return value == null ? null : reportHash(value, label);
	}

	static function reportHash(value:String, label:String):String {
		if (StringTools.startsWith(value, "sha256:"))
			return value;
		if (!~/^[0-9a-f]{64}$/.match(value))
			throw 'OCaml target reuse $label is not a SHA-256 value.';
		return "sha256:" + value;
	}
}
#end
