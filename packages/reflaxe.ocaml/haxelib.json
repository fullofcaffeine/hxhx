  "description": "A Haxe compilation target for OCaml (via Reflaxe), enabling native OCaml output, OCaml interop, and a path toward Haxe-in-Haxe bootstrapping.",
  "version": "0.33.3",
  "classPath": "src/",
  "releasenote": "v0.33.3: See CHANGELOG.md",
  "contributors": [
    "fullofcaffeine"
  ],
  "dependencies": {
    "reflaxe": "^4.0.0"
  },
  "main": "reflaxe.ocaml.tooling.ReflaxeOcamlRun",
  "reflaxe": {
    "name": "OCaml",
    "abbv": "ocaml",
    "stdPaths": [
      "std",
      "std/ocaml/_std"
    ]
  }
}
