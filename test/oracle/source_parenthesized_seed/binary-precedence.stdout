left in middle = right	OpIn(left,OpAssign(middle,right))
left = middle in right	OpAssign(left,OpIn(middle,right))
left => middle = right	OpArrow(left,OpAssign(middle,right))
left = middle => right	OpAssign(left,OpArrow(middle,right))
left in middle => right	OpIn(left,OpArrow(middle,right))
left => middle in right	OpArrow(left,OpIn(middle,right))
left in middle in right	OpIn(left,OpIn(middle,right))
left => middle => right	OpArrow(left,OpArrow(middle,right))
left in middle + right	OpIn(left,OpAdd(middle,right))
left + middle in right	OpAdd(left,OpIn(middle,right))
left => middle + right	OpArrow(left,OpAdd(middle,right))
left + middle => right	OpArrow(OpAdd(left,middle),right)
left in middle || right	OpIn(left,OpBoolOr(middle,right))
left || middle in right	OpBoolOr(left,OpIn(middle,right))
left => middle ?? right	OpArrow(left,OpNullCoal(middle,right))
left ?? middle => right	OpArrow(OpNullCoal(left,middle),right)
left in flag ? yes : no	if(OpIn(left,flag),yes,no)
flag ? yes : no in right	if(flag,yes,OpIn(no,right))
left => flag ? yes : no	OpArrow(left,if(flag,yes,no))
flag ? yes : no => right	if(flag,yes,OpArrow(no,right))
